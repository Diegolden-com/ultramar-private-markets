{
  "name": "project-ultramar",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:ultramar": "yarn workspace @ultramar/ultramar dev",
    "dev:capital": "yarn workspace @ultramar/capital dev",
    "dev:polymarket": "yarn workspace @ultramar/polymarket dev",
    "dev:private-equities": "yarn workspace @ultramar/private-equities dev",
    "build": "yarn workspaces foreach -Apt run build",
    "lint": "yarn workspaces foreach -Apt run lint",
    "typecheck": "yarn workspace @ultramar/ultramar typecheck && yarn workspace @ultramar/polymarket typecheck",
    "hookathon:check": "yarn workspace @ultramar/ultramar lint && yarn workspace @ultramar/ultramar typecheck && yarn workspace @ultramar/ultramar build && cd apps/private-equities/contracts && forge test && forge script script/CapitalWindowDemo.s.sol:CapitalWindowDemo -vv",
    "hookathon:capture:demo": "node scripts/hookathon-capture-demo.mjs",
    "hookathon:render:video": "node scripts/hookathon-render-video.mjs",
    "hookathon:links:check": "node scripts/hookathon-public-links-check.mjs",
    "hookathon:public:render:qa": "node scripts/hookathon-public-render-qa.mjs",
    "hookathon:privacy:check": "node scripts/hookathon-privacy-check.mjs",
    "hookathon:readiness": "node scripts/hookathon-readiness-report.mjs",
    "hookathon:submission:operator": "node scripts/hookathon-final-submit-run.mjs",
    "hookathon:submission:handoff": "node scripts/hookathon-submission-handoff.mjs",
    "hookathon:submission:preflight": "node scripts/hookathon-submission-preflight.mjs",
    "hookathon:submission:preflight:strict": "node scripts/hookathon-submission-preflight.mjs --strict-external",
    "hookathon:submission:receipt": "node scripts/hookathon-submission-receipt.mjs",
    "hookathon:tally:field-map": "node scripts/hookathon-tally-field-map.mjs",
    "hookathon:tally:fill-plan": "node scripts/hookathon-tally-fill-plan.mjs",
    "hookathon:tally:personalize": "node scripts/hookathon-personalize-tally.mjs",
    "hookathon:tally:session:qa": "node scripts/hookathon-tally-session-qa.mjs",
    "hookathon:tally:session": "node scripts/hookathon-tally-session-pack.mjs",
    "hookathon:video:proof": "node scripts/hookathon-video-proof.mjs",
    "hookathon:testnet:dry-run": "cd apps/private-equities/contracts && DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 forge script script/DeployCapitalWindowTestnet.s.sol:DeployCapitalWindowTestnet --rpc-url https://sepolia.base.org -vv",
    "hookathon:testnet:e2e": "cd apps/private-equities/contracts && DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80 CAPITAL_WINDOW_RUN_SMOKE_SWAP=true forge script script/DeployCapitalWindowTestnet.s.sol:DeployCapitalWindowTestnet --rpc-url https://sepolia.base.org -vv"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.105.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.14.0",
    "next": "16.2.6",
    "next-themes": "0.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-is": "19.2.6",
    "recharts": "3.8.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.7.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "daisyui": "5.5.20",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.14",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
