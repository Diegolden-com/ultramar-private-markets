{
  "name": "project-ultramar",
  "private": true,
  "packageManager": "yarn@4.12.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:ultramar": "yarn workspace @ultramar/ultramar dev",
    "dev:realestate": "yarn workspace @ultramar/realestate dev",
    "dev:capital": "yarn workspace @ultramar/capital dev",
    "dev:polymarket": "yarn workspace @ultramar/polymarket dev",
    "dev:private-equities": "yarn workspace @ultramar/private-equities dev",
    "test:qa:ultramar:local": "yarn workspace @ultramar/ultramar test:qa:local",
    "copy:measure": "node scripts/measure-visible-copy.mjs",
    "build": "yarn workspaces foreach -Apt run build",
    "lint": "yarn workspaces foreach -Apt run lint",
    "typecheck": "yarn workspace @ultramar/ultramar typecheck && yarn workspace @ultramar/realestate typecheck && yarn workspace @ultramar/polymarket typecheck"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@supabase/ssr": "0.10.3",
    "@supabase/supabase-js": "2.105.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.14.0",
    "next": "16.2.6",
    "next-themes": "0.4.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-is": "19.2.6",
    "recharts": "3.8.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "25.7.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "daisyui": "5.5.20",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "postcss": "8.5.14",
    "tailwindcss": "4.3.0",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  }
}
